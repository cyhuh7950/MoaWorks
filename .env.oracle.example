APP_NAME=MoaWorks
APP_ENV=oracle
APP_LOCALE=ko-KR
APP_TIMEZONE=Asia/Seoul

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8510
FRONTEND_PORT=3510
USER_WEB_PORT=3520

POSTGRES_DB=moaworks
POSTGRES_USER=moaworks
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_PUBLIC_PORT=5435

MAIL_LAYER_HOST=mail-layer
MAIL_LAYER_SMTP_PORT=587
MAIL_LAYER_IMAP_PORT=993
MAIL_HOSTNAME=mail.moaworks.sinsan.kr
MAIL_INGEST_TOKEN=replace-with-a-long-random-internal-token
MAIL_INBOUND_MAX_MESSAGE_BYTES=26214400

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/storage
MAIL_BACKUP_POLL_SECONDS=5
MAIL_BACKUP_LEASE_MINUTES=10
MAIL_BACKUP_TTL_HOURS=24
MAIL_RETENTION_POLL_SECONDS=60
MAIL_RETENTION_BATCH_SIZE=500

WATCHER_ENABLED=true
WATCHER_INTERVAL_SECONDS=60

TRANSLATION_ENABLED=false
TRANSLATION_PROVIDER=disabled

SETUP_SECRET_KEY=change-this-to-a-long-random-secret
CORS_ALLOWED_ORIGINS=["https://admin.moaworks.sinsan.kr","https://user.moaworks.sinsan.kr"]
