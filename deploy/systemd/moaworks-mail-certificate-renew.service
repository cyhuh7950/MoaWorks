[Unit]
Description=MoaWorks SMTP certificate renewal
ConditionVirtualization=wsl
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/moaworks/mail-certificate-renew.env
ExecStart=/usr/local/libexec/moaworks/renew-mail-gateway-certificate.sh
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
