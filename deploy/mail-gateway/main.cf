compatibility_level = 3.6
maillog_file = /dev/stdout
import_environment = MAIL_INGEST_TOKEN MAIL_INGEST_URL
export_environment = TZ MAIL_CONFIG LANG MAIL_INGEST_TOKEN MAIL_INGEST_URL
myhostname = ${MAIL_HOSTNAME}
myorigin = $myhostname
mydestination = localhost
inet_interfaces = all
inet_protocols = all
smtpd_banner = $myhostname ESMTP MoaWorks
disable_vrfy_command = yes
smtpd_helo_required = yes
message_size_limit = 26214400
smtpd_recipient_limit = 100
virtual_mailbox_domains = pgsql:/etc/postfix/pgsql-virtual-domains.cf
virtual_mailbox_maps = pgsql:/etc/postfix/pgsql-virtual-recipients.cf
virtual_transport = moaworks-ingest:
relay_domains = ${SMTP_RELAY_DOMAINS}
transport_maps = hash:/etc/postfix/transport
parent_domain_matches_subdomains = debug_peer_list, fast_flush_domains, mynetworks, permit_mx_backup_networks, qmqpd_authorized_clients, postscreen_access_list, smtpd_client_event_limit_exceptions
moaworks-ingest_destination_recipient_limit = 1
smtpd_recipient_restrictions = reject_unlisted_recipient, reject_unauth_destination, check_recipient_access hash:/etc/postfix/relay-recipient-verification
smtpd_restriction_classes = verify_relay_recipient
verify_relay_recipient = reject_unverified_recipient
unverified_recipient_reject_code = 550
unverified_recipient_defer_code = 450
unverified_recipient_tempfail_action = defer
unverified_recipient_reject_reason = Recipient address verification failed
smtpd_milters = inet:rspamd:11332
non_smtpd_milters = $smtpd_milters
milter_default_action = tempfail
milter_protocol = 6
smtpd_tls_security_level = ${SMTPD_TLS_SECURITY_LEVEL}
smtpd_tls_cert_file = ${SMTPD_TLS_CERT_FILE}
smtpd_tls_key_file = ${SMTPD_TLS_KEY_FILE}
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_loglevel = 1
maximal_queue_lifetime = 5d
bounce_queue_lifetime = 5d
queue_directory = /var/spool/postfix
