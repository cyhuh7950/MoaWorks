compatibility_level = 3.6
myhostname = ${MAIL_HOSTNAME}
myorigin = $myhostname
mydestination = localhost
inet_interfaces = all
inet_protocols = all
smtpd_banner = $myhostname ESMTP MoaWorks
disable_vrfy_command = yes
smtpd_helo_required = yes
message_size_limit = 26214400
smtpd_recipient_limit = 100
virtual_mailbox_domains = pgsql:/etc/postfix/pgsql-virtual-domains.cf
virtual_mailbox_maps = pgsql:/etc/postfix/pgsql-virtual-recipients.cf
virtual_transport = moaworks-ingest:
moaworks-ingest_destination_recipient_limit = 1
smtpd_recipient_restrictions = reject_unlisted_recipient, reject_unauth_destination
smtpd_milters = inet:rspamd:11332
non_smtpd_milters = $smtpd_milters
milter_default_action = tempfail
milter_protocol = 6
smtpd_tls_security_level = may
smtpd_tls_loglevel = 1
maximal_queue_lifetime = 5d
bounce_queue_lifetime = 5d
queue_directory = /var/spool/postfix
