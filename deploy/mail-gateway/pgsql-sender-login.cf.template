hosts = ${POSTGRES_HOST}:${POSTGRES_PORT}
user = ${POSTGRES_USER}
password = ${POSTGRES_PASSWORD}
dbname = ${POSTGRES_DB}
query = SELECT c.username FROM mail_submission_credentials c JOIN users u ON u.id=c.user_id AND u.company_id=c.company_id JOIN mail_accounts a ON a.user_id=u.id JOIN mail_addresses ma ON ma.user_id=u.id AND ma.company_id=u.company_id JOIN mail_managed_domains d ON d.company_id=ma.company_id AND d.domain=split_part(ma.address,'@',2) WHERE c.active=TRUE AND c.revoked_at IS NULL AND u.status='active' AND a.status='active' AND LOWER(c.username)=LOWER(u.email) AND LOWER(a.email)=LOWER(u.email) AND ma.address=LOWER('%s') AND ma.active=TRUE AND ma.send_enabled=TRUE AND d.status='active'
