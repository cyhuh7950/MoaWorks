hosts = ${POSTGRES_HOST}:${POSTGRES_PORT}
user = ${POSTGRES_USER}
password = ${POSTGRES_PASSWORD}
dbname = ${POSTGRES_DB}
query = SELECT 1 FROM mail_managed_domains d WHERE d.domain=LOWER(split_part('%s','@',2)) AND d.status='active' AND (LOWER(split_part('%s','@',1)) ~ '^bounce\+delivery_[a-z0-9_-]+$' OR EXISTS (SELECT 1 FROM mail_addresses a JOIN users u ON u.id=a.user_id AND u.company_id=a.company_id WHERE a.company_id=d.company_id AND a.address=LOWER('%s') AND a.active=TRUE AND u.status='active')) LIMIT 1
