hosts = ${POSTGRES_HOST}:${POSTGRES_PORT}
user = ${POSTGRES_USER}
password = ${POSTGRES_PASSWORD}
dbname = ${POSTGRES_DB}
query = SELECT 1 FROM users u JOIN companies c ON c.id = u.company_id JOIN mail_domain_settings d ON d.company_id = c.id WHERE u.status = 'active' AND LOWER(u.email) = LOWER('%s') AND LOWER(split_part(u.email, '@', 2)) = LOWER(d.mail_domain) LIMIT 1
