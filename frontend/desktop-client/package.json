{
  "name": "moaworks-desktop-client",
  "productName": "MoaWorks Desktop Client",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "test": "node --test test\\*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 test\\*.test.js",
    "check:storage": "node --test test\\archive-service.test.js",
    "build": "node ./scripts/package-desktop-client.js",
    "package": "node ./scripts/package-desktop-client.js"
  },
  "devDependencies": {
    "electron": "32.2.1"
  }
}
