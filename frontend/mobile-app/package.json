{
  "name": "moaworks-mobile-app",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "react-native start",
    "test": "node --test test\\*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 test\\*.test.js",
    "bundle": "node ./scripts/mobile-app-build-smoke.js",
    "build": "node ./scripts/mobile-package-android.js",
    "package:android": "node ./scripts/mobile-package-android.js",
    "build:android": "node ./scripts/mobile-android-command.js release",
    "build:public:android": "node ./scripts/mobile-package-public-android.js",
    "android": "node ./scripts/mobile-android-command.js run",
    "ios": "react-native run-ios",
    "build:ios": "node ./scripts/mobile-ios-command.js build",
    "package:ios": "node ./scripts/mobile-ios-command.js archive"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.75.4"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.75.4",
    "@react-native/metro-config": "0.75.4"
  }
}
